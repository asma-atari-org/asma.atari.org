<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.atari.asma</groupId>
		<artifactId>asma-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>asma-tools</artifactId>
	<packaging>jar</packaging>

	<name>ASMA Tools</name>
	<description>Site generation tools (ASMAExporter, DemozooImporter) and the SAPFileEditor GUI.
		Depends on the patched ASAP build with the POKEY frame dump API, see ASAP.md.</description>

	<dependencies>
		<dependency>
			<groupId>org.atari.asma</groupId>
			<artifactId>asma-lib</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<dependency>
			<groupId>net.sf.asap</groupId>
			<artifactId>asap</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Produces target/SAPFileEditor.jar, the runnable fat jar that replaces
				the Eclipse "Runnable JAR with jar-in-jar loader" export. The regular
				asma-tools-*.jar artifact is left untouched. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<id>sap-file-editor</id>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<outputFile>${project.build.directory}/SAPFileEditor.jar</outputFile>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.atari.asma.editor.SAPFileEditor</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>module-info.class</exclude>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Packs target/SAPFileEditor.zip (fat jar + Windows starter), the
				distributable that used to be assembled by ant from the Eclipse
				export. Runs after the shade execution in the same phase. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>sap-file-editor-zip</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<descriptors>
								<descriptor>src/assembly/SAPFileEditor-zip.xml</descriptor>
							</descriptors>
							<finalName>SAPFileEditor</finalName>
							<appendAssemblyId>false</appendAssemblyId>
							<attach>false</attach>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
