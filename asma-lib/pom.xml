<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.atari.asma</groupId>
		<artifactId>asma-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>asma-lib</artifactId>
	<packaging>jar</packaging>

	<name>ASMA Library</name>
	<description>Library to consume the content of the ASMA website (asmadb.js/asmadb.json database,
		SAP/SAP-R/RMT/TTT file formats, STIL and Demozoo metadata) from Java.</description>

	<dependencies>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
		</dependency>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!-- Regenerates ASTIL.java from ASTIL.fu with the Fusion transpiler.
			Replaces the former Eclipse external builder (Fusion.launch).
			Usage: mvn -Pastil generate-sources
			The transpiler location can be overridden with -Dfut.executable=... -->
		<profile>
			<id>astil</id>
			<properties>
				<fut.executable>C:\jac\system\Windows\Tools\FUT\Fusion\fut.exe</fut.executable>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>generate-astil</id>
								<phase>generate-sources</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${fut.executable}</executable>
									<workingDirectory>${project.basedir}/src/main/java/org/atari/asma/stil</workingDirectory>
									<arguments>
										<argument>-o</argument>
										<argument>ASTIL.java</argument>
										<argument>-n</argument>
										<argument>org.atari.asma.stil</argument>
										<argument>ASTIL.fu</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
