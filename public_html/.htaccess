# Default caching: 1 hour. This host does not process mod_expires
# (no Expires headers were ever sent), so the policy is set via
# mod_headers, which is verified to work here. The asmadb directory
# overrides this with "no-cache" for the application files.
Header set Cache-Control "max-age=3600"

# Allow external players to use the files directly.
Header set Access-Control-Allow-Origin "*"

<FilesMatch ".(ttt|sap)$">
Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</FilesMatch>
